        if action == "list":
            wins = [w.title for w in gw.getAllWindows() if w.title]
            return {"windows": wins[:50], "total": len(wins)}
        if not title:
            return {"error": f"title kosong untuk '{action}'."}
        wins = gw.getWindowsWithTitle(title)
        if not wins:
            return {"error": f"Window tidak ditemukan: {title!r}"}
        w = wins[0]
        if not ask_permission(f"Window: {action} → {w.title!r}"):
            return {"error": "Ditolak."}
        if action == "activate":
            if w.isMinimized: w.restore()
            w.activate(); time.sleep(0.2)
        elif action == "minimize":
            w.minimize()
        elif action == "maximize":
            w.maximize()
        elif action == "close":
            w.close()
        else:
            return {"error": f"Window action tidak dikenal: {action}"}
        return {"action": action, "title": w.title, "done": True}
    except Exception as exc:
        return {"error": f"Window gagal: {type(exc).__name__}: {exc}"}


_WIN_APP_MAP = {
    "code": "code", "vscode": "code", "vs code": "code", "vs_code": "code",
    "notepad": "notepad", "calc": "calc", "calculator": "calc",
    "explorer": "explorer", "file explorer": "explorer",
    "cmd": "cmd", "powershell": "powershell", "pwsh": "powershell",
    "paint": "mspaint", "mspaint": "mspaint",
    "chrome": "chrome", "google chrome": "chrome",
    "edge": "msedge", "msedge": "msedge",
    "firefox": "firefox", "word": "winword", "excel": "excel",
    "terminal": "wt", "windows terminal": "wt",
}


def win_open(params: dict[str, Any], base: Path) -> dict[str, Any]:
    app_raw = params.get("app")
    app = str(app_raw).strip() if app_raw is not None else ""
    args_raw = params.get("args")
    args = str(args_raw).strip() if args_raw is not None else ""
    
    if not app:
        return {"error": "Parameter 'app' kosong atau tidak valid."}
        
    exe = _WIN_APP_MAP.get(app.lower(), app)
    if not ask_permission(f"Buka aplikasi: {app} {args}".strip()):
        return {"error": "Ditolak."}
    try:
        if IS_WINDOWS:
            cmd = f'start "" "{exe}"'
            if args:
                cmd += f" {args}"
            subprocess.Popen(cmd, shell=True, cwd=base)
        elif platform.system() == "Darwin":
            subprocess.Popen(["open", "-a", exe] + (shlex.split(args) if args else []))
        else:
            subprocess.Popen([exe] + (shlex.split(args) if args else []), cwd=base)
        time.sleep(1.2)
        return {"app": app, "exe": exe, "args": args, "launched": True}
    except Exception as exc:
        return {"error": f"Gagal buka {app}: {type(exc).__name__}: {exc}"}


def run_command(command: str, base: Path, mode: str = "coding") -> dict[str, Any]:
    if mode == "hacking":
        return run_hacking_command(command, base)
    if mode == "windows":
        return run_windows_command(command, base)
    return run_coding_command(command, base)


# ---------- Action validation & dispatch ----------
def validate_action(payload: Any, mode: str = "coding") -> tuple[str, dict[str, Any]]:
    if not isinstance(payload, dict):
        raise ValueError("Bukan JSON object.")
    action = payload.get("action")
    params = payload.get("parameters")
    allowed = set(ACTIONS_BY_MODE.get(mode, ACTIONS_BY_MODE["coding"]))
    if action not in allowed:
        raise ValueError(f"Action tidak dikenal untuk mode {mode}: {action!r}. "
                         f"Diizinkan: {sorted(allowed)}")
    if not isinstance(params, dict):
        raise ValueError("Parameters bukan object.")
    required = {
        "chat": ("message",),
        "search_code": ("query",),
        "read_file": ("path",),
        "write_file": ("path", "content"),
        "run_command": ("command",),
        "screenshot": (),
        "mouse": ("action",),
        "keyboard": ("action",),
        "window": ("action",),
        "open": ("app",),
    }
    
    # Auto-fix: Jika AI pakai nama parameter lain untuk 'app'
    if action == "open":
        for alt in ("app_name", "application", "program", "name"):
            if alt in params and "app" not in params:
                params["app"] = params.pop(alt)

    for f in required.get(action, ()):
        if f not in params:
            raise ValueError(f"Parameter '{f}' hilang untuk action {action}.")
        if not isinstance(params[f], str):
            # Coba koreksi otomatis jika angka/boolean
            if isinstance(params[f], (int, float, bool)):
                params[f] = str(params[f])
            elif params[f] is None:
                raise ValueError(f"Parameter '{f}' bernilai null (None) untuk action {action}.")
            else:
                raise ValueError(f"Parameter '{f}' harus string, bukan {type(params[f]).__name__} (action {action}).")
    return action, params


def execute_action(action: str, params: dict[str, Any], base: Path,
                   mode: str = "coding") -> tuple[Any, Optional[str]]:
    def s(n: str) -> str:
        v = params.get(n)
        return str(v) if v is not None else ""

    if action == "chat":
        return None, s("message")
    if action == "search_code":
        return search_code(s("query"), s("path") or ".",
                           s("file_pattern") or "*", base), None
    if action == "read_file":
        return read_file(s("path"), base), None
    if action == "write_file":
        c = params.get("content")
        return write_file(s("path"), c if isinstance(c, str) else "", base), None
    if action == "run_command":
        return run_command(s("command"), base, mode=mode), None
    if action == "screenshot":
        return win_screenshot(base), None
    if action == "mouse":
        return win_mouse(params), None
    if action == "keyboard":
        return win_keyboard(params), None
    if action == "window":
        return win_window(params), None
    if action == "open":
        return win_open(params, base), None
    return {"error": "Action tidak didukung."}, None


# ---------- Multi-step turn executor ----------
def run_turn(llm: BaseLLMClient, user_input: str, base: Path, mode: str,
             on_action: Callable[[str], None],
             on_chat: Callable[[str], None],
             on_info: Callable[[str], None]) -> None:
    max_steps = MAX_STEPS_BY_MODE.get(mode, 4)
    prompt = user_input
    pending_image: Optional[str] = None
    parse_retries = 0

    for step in range(max_steps):
        try:
            if pending_image and llm.supports_vision():
                raw = llm.send_message_with_image(prompt, pending_image)
            else:
                raw = llm.send_message(prompt)
            pending_image = None
            
            # === FITUR BARU: Jika AI balas teks biasa (bukan JSON), anggap CHAT ===
            try:
                action, params = validate_action(parse_ai_response(raw), mode=mode)
            except ValueError as parse_err:
                # Kalau teksnya tidak mengandung kurung kurawal JSON sama sekali,
                # itu berarti AI sedang ngobrol santai.
                if "{" not in raw:
                    action = "chat"
                    params = {"message": raw.strip()}
                else:
                    raise parse_err
            
            parse_retries = 0  # reset on success
        except ValueError as exc:
            # === FITUR SELF-CORRECTION ===
            parse_retries += 1
            if parse_retries >= 3:
                on_chat(f"[error parse] Gagal setelah 3x percobaan: {exc}")
                return
            
            on_info(f"[Self-Correct] AI salah format JSON ({exc}). Meminta AI memperbaiki...")
            
            action_tried = ""
            try:
                raw_json = parse_ai_response(raw)
                action_tried = raw_json.get("action", "")
            except:
                pass
                
            schema_hint = ""
            if action_tried == "open":
                schema_hint = 'Contoh JSON benar: {"action": "open", "parameters": {"app": "notepad"}}'
            elif action_tried == "keyboard":
                schema_hint = 'Contoh JSON benar: {"action": "keyboard", "parameters": {"action": "write", "text": "halo dunia"}}'
            
            prompt = (
                f"Respons JSON sebelumnya GAGAL divalidasi: {exc}\n"
                f"{schema_hint}\n"
                f"PENTING: Lakukan HANYA SATU action per respons. Jika tugas butuh dua langkah "
                f"(misal: 'buka notepad' LALU 'ketik teks'), lakukan langkah pertama dulu (buka notepad saja). "
                f"Langkah kedua akan kamu lakukan setelah menerima hasil dari langkah pertama.\n"
                f"Tolong perbaiki format JSON-mu dan kirim ulang action yang benar."
            )
            continue
        except Exception as exc:
            on_chat(f"[error provider] {type(exc).__name__}: {exc}")
            return

        if action == "chat":
            on_chat(params.get("message", ""))
            return

        on_action(action)
        try:
            result, _ = execute_action(action, params, base, mode=mode)
        except Exception as exc:
            result = {"error": f"{type(exc).__name__}: {exc}"}

        # Attach screenshot for next step
        if action == "screenshot" and isinstance(result, dict) and "path" in result:
            pending_image = str(base / result["path"])

        if step == max_steps - 1:
            on_chat(f"[berhenti setelah {max_steps} langkah]")
            return

        prompt = (
            "Hasil action sebelumnya (JSON):\n"
            + json.dumps(result, ensure_ascii=False)
            + "\n\nLanjutkan dengan action berikutnya, atau akhiri dengan "
              "'chat' jika sudah selesai. Jangan ulangi action yang sudah "
              "berhasil. Jika action ditolak user, sesuaikan pendekatan."
        )
        if pending_image and not llm.supports_vision():
            on_info(f"[vision tidak tersedia; AI hanya tahu path {pending_image}]")


