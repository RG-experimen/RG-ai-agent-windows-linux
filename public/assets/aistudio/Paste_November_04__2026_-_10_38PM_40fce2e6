def win_mouse(params: dict[str, Any]) -> dict[str, Any]:
    try:
        pg = _lazy_pyautogui()
    except RuntimeError as exc:
        return {"error": str(exc)}
    action = (params.get("action") or "").lower()
    x = params.get("x"); y = params.get("y")
    if action in {"move", "click", "doubleclick", "rightclick", "drag"}:
        if not (isinstance(x, int) and isinstance(y, int)):
            return {"error": f"x,y harus integer untuk '{action}'."}
    desc = {
        "move":       f"gerakkan mouse ke ({x},{y})",
        "click":      f"klik kiri di ({x},{y})",
        "doubleclick":f"double-click di ({x},{y})",
        "rightclick": f"klik kanan di ({x},{y})",
        "drag":       f"drag ke ({x},{y})",
        "scroll":     f"scroll {params.get('amount', 0)} di ({x},{y})",
    }.get(action, action)
    if not ask_permission(f"Mouse: {desc}"):
        return {"error": "Ditolak."}
    try:
        dur = float(params.get("duration", 0.2))
        if action == "move":
            pg.moveTo(x, y, duration=dur)
        elif action == "click":
            pg.click(x, y, clicks=int(params.get("clicks", 1)),
                     button=params.get("button", "left"), duration=dur)
        elif action == "doubleclick":
            pg.doubleClick(x, y, button=params.get("button", "left"))
        elif action == "rightclick":
            pg.rightClick(x, y)
        elif action == "drag":
            pg.dragTo(x, y, duration=dur, button=params.get("button", "left"))
        elif action == "scroll":
            pg.scroll(int(params.get("amount", 0)), x=x, y=y)
        else:
            return {"error": f"Mouse action tidak dikenal: {action}"}
        return {"action": action, "x": x, "y": y, "done": True}
    except Exception as exc:
        return {"error": f"Mouse gagal: {type(exc).__name__}: {exc}"}


def win_keyboard(params: dict[str, Any]) -> dict[str, Any]:
    try:
        pg = _lazy_pyautogui()
    except RuntimeError as exc:
        return {"error": str(exc)}
    action = (params.get("action") or "").lower()
    text = params.get("text") or ""
    keys = params.get("keys")
    if isinstance(keys, str):
        keys = keys.split("+") if action == "hotkey" else [keys]
    if action == "write" and not text:
        return {"error": "text kosong untuk write."}
    if action in {"press", "hotkey"} and not keys:
        return {"error": f"keys kosong untuk {action}."}
    if action == "paste" and not text:
        return {"error": "text kosong untuk paste."}

    preview = text if len(text) <= 200 else text[:200] + "..."
    desc = {
        "write": f"ketik teks ({len(text)} char): {preview!r}",
        "press": f"tekan {keys}",
        "hotkey": f"hotkey {'+'.join(keys) if keys else ''}",
        "paste": f"paste {len(text)} char via clipboard: {preview!r}",
    }.get(action, action)
    if not ask_permission(f"Keyboard: {desc}"):
        return {"error": "Ditolak."}
    try:
        if action == "write":
            pg.write(text, interval=float(params.get("interval", 0.02)))
        elif action == "press":
            for k in keys:
                pg.press(k)
        elif action == "hotkey":
            pg.hotkey(*keys)
        elif action == "paste":
            try:
                import pyperclip
            except ImportError:
                return {"error": "pyperclip belum terpasang. pip install pyperclip"}
            pyperclip.copy(text)
            time.sleep(0.05)
            pg.hotkey("ctrl", "v")
        else:
            return {"error": f"Keyboard action tidak dikenal: {action}"}
        return {"action": action, "done": True}
    except Exception as exc:
        return {"error": f"Keyboard gagal: {type(exc).__name__}: {exc}"}


