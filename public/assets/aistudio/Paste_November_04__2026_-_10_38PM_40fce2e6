    def _append(self, tag: str, text: str) -> None:
        if self.chat is None: return
        try:
            self.chat.configure(state=tk.NORMAL)
            self.chat.insert(tk.END, f"\n{tag}: ", tag)
            self.chat.insert(tk.END, text + "\n")
            self.chat.configure(state=tk.DISABLED)
            self.chat.see(tk.END)
        except tk.TclError:
            pass

    def _append_block(self, tag: str, text: str) -> None:
        if self.chat is None: return
        try:
            self.chat.configure(state=tk.NORMAL)
            self.chat.insert(tk.END, "\n", tag)
            self.chat.insert(tk.END, text + "\n", tag)
            self.chat.configure(state=tk.DISABLED)
            self.chat.see(tk.END)
        except tk.TclError:
            pass

    def _post(self, kind: str, *payload: Any) -> None:
        self._queue.put((kind, payload))

    def _poll_queue(self) -> None:
        try:
            while True:
                kind, payload = self._queue.get_nowait()
                if kind == "append":
                    self._append(payload[0], payload[1])
                elif kind == "status" and self.status is not None:
                    try: self.status.config(text=payload[0])
                    except tk.TclError: pass
                elif kind == "enable_input":
                    self._busy = False
                    if self.send_btn is not None:
                        try: self.send_btn.config(state=tk.NORMAL)
                        except tk.TclError: pass
                    if self.entry is not None:
                        try:
                            self.entry.config(state=tk.NORMAL)
                            self.entry.focus_set()
                        except tk.TclError: pass
        except queue.Empty:
            pass
        if not self._shutting_down:
            try: self.root.after(80, self._poll_queue)
            except tk.TclError: pass

    def _send(self) -> None:
        if self._busy or self._shutting_down or self.entry is None:
            return
        txt = self.entry.get().strip()
        if not txt:
            return
        if txt.casefold() in {"exit", "quit"}:
            self._on_close(); return
        self.entry.delete(0, tk.END)
        self._append("You", txt)
        self._busy = True
        if self.send_btn is not None:
            self.send_btn.config(state=tk.DISABLED)
        if self.entry is not None:
            self.entry.config(state=tk.DISABLED)
        if self.status is not None:
            self.status.config(text="Thinking...")
        threading.Thread(target=self._process, args=(txt,), daemon=True).start()

    def _process(self, user_input: str) -> None:
        # Direct execution: !command
        if user_input.startswith("!"):
            cmd = user_input[1:].strip()
            if not cmd:
                self._post("append", "Info", "Command kosong setelah '!'.")
                self._post("enable_input"); return
            try:
                result = run_command(cmd, self.base, mode=self.mode)
                out = (result.get("stdout") or result.get("stderr")
                       or result.get("error") or "")
                self._post("append", "Info", f"$ {cmd}")
                self._post("append", "Agent", out or "(no output)")
            except Exception as exc:
                self._post("append", "Error", f"{type(exc).__name__}: {exc}")
            finally:
                self._post("enable_input")
                self._post("status", "Ready")
            return

        llm = self.llm
        if llm is None:
            self._post("append", "Error", "Provider belum dipilih.")
            self._post("enable_input"); return
        try:
            run_turn(
                llm, user_input, self.base, self.mode,
                on_action=lambda a: self._post("append", "Info", f"[action: {a}]"),
                on_chat=lambda m: self._post("append", "Agent", m),
                on_info=lambda m: self._post("append", "Info", m),
            )
        except Exception as exc:
            self._post("append", "Error", f"{type(exc).__name__}: {exc}")
        finally:
            self._post("enable_input")
            self._post("status", "Ready")

    def _ask_permission(self, description: str) -> bool:
        if self._shutting_down:
            return False
        try:
            if not self.root.winfo_exists():
                return False
        except tk.TclError:
            return False
        res = [False]; ev = threading.Event()
        def show():
            try:
                if self._shutting_down: return
                res[0] = messagebox.askyesno("Permission Required",
                                             description, parent=self.root)
            except tk.TclError:
                pass
            finally:
                ev.set()
        try: self.root.after(0, show)
        except tk.TclError: return False
        while not ev.wait(timeout=0.1):
            if self._shutting_down:
                return False
        return bool(res[0]) and not self._shutting_down

    def _reset_to_selection(self) -> None:
        if self._busy:
            messagebox.showinfo("Busy", "Tunggu request selesai.", parent=self.root); return
        if self.llm:
            try: self.llm.close()
            except Exception: pass
            self.llm = None
        self.provider = None; self._gemini_mode = None
        self._show_provider_selection()

    def _change_model(self) -> None:
        if self._busy:
            messagebox.showinfo("Busy", "Tunggu request selesai.", parent=self.root); return
        if not self.provider or not self.llm:
            messagebox.showinfo("Info", "Pilih provider dulu.", parent=self.root); return
        if self.provider == "gemini":
            env_var, cur = "GEMINI_MODEL", get_model_for("gemini")
        elif self.provider == "claude":
            env_var, cur = "CLAUDE_MODEL", get_model_for("claude")
        else:
            cfg = OpenAICompatibleClient.PROVIDER_CONFIG.get(self.provider)
            if not cfg: return
            env_var, cur = cfg["model_env"], get_model_for(self.provider)
        new = simpledialog.askstring("Ganti Model",
            f"Model {self.provider}: {cur}\n\nModel baru:",
            initialvalue=cur, parent=self.root)
        if not new or new.strip() == cur:
            return
        new = new.strip()
        os.environ[env_var] = new
        # For Gemini, update fallback chain so next create_llm_client uses new model first
        if self.provider == "gemini":
            GEMINI_MODEL_FALLBACKS[0] = new
        try:
            new_llm = create_llm_client(self.provider,
                                         gemini_mode=self._gemini_mode, mode=self.mode)
        except Exception as exc:
            messagebox.showerror("Error", f"Gagal: {exc}", parent=self.root)
            os.environ[env_var] = cur; return
        if self.llm:
            try: self.llm.close()
            except Exception: pass
        self.llm = new_llm
        self._show_chat()
        self._append("Info", f"Model diubah ke: {new}")

    def _on_close(self) -> None:
        self._shutting_down = True
        try: self.root.destroy()
        except tk.TclError: pass

    def run(self) -> None:
        global PERMISSION_HANDLER
        PERMISSION_HANDLER = self._ask_permission
        try:
            self.root.mainloop()
        finally:
            self._shutting_down = True
            PERMISSION_HANDLER = None
            if self.llm:
                try: self.llm.close()
                except Exception: pass


# ---------- CLI loop ----------
def run_cli(llm: BaseLLMClient, provider: str, base: Path, mode: str = "coding") -> int:
    print(f"\n=== AI Agent (CLI) — Mode: {MODE_NAMES[mode]} ===")
    print(f"Provider: {PROVIDER_NAMES[provider]}  |  Dir: {base}")
    print(format_welcome(provider, base, mode))
    try:
        while True:
            try:
                ui = input("\nYou: ").strip()
            except (EOFError, KeyboardInterrupt):
                print("\nSampai jumpa."); break
            if not ui: continue
            if ui.casefold() in {"exit", "quit"}:
                print("Sampai jumpa."); break

            if ui.startswith("!"):
                cmd = ui[1:].strip()
                if not cmd:
                    print("Command kosong setelah '!'."); continue
                result = run_command(cmd, base, mode=mode)
                out = (result.get("stdout") or result.get("stderr")
                       or result.get("error") or "")
                if out:
                    print(out, end="" if out.endswith("\n") else "\n")
                continue

            try:
                run_turn(
                    llm, ui, base, mode,
                    on_action=lambda a: print(f"[action: {a}]"),
                    on_chat=lambda m: print(f"Agent: {m}"),
                    on_info=lambda m: print(f"[info] {m}"),
                )
            except PermissionError as exc:
                print(f"Error Permission: {exc}")
            except Exception as exc:
                print(f"Error: {type(exc).__name__}: {exc}", file=sys.stderr)
    finally:
        llm.close()
    return 0


# ---------- Help ----------
def print_help() -> None:
    try:
        text = Path(__file__).read_text(encoding="utf-8")
    except OSError:
        print("(lihat header agent.py)"); return
    for line in text.splitlines():
        s = line.lstrip()
        if s.startswith("#"):
            print(s[1:].lstrip("#").rstrip())
        elif line.startswith("from __future__"):
            break


# ---------- Main ----------
def main() -> int:
    if "--help" in sys.argv or "-h" in sys.argv:
        print_help(); return 0

    check = "--check" in sys.argv
    no_menu = "--no-menu" in sys.argv
    force_gui = "--gui" in sys.argv
    force_cli = "--cli" in sys.argv
    force_coding = "--coding" in sys.argv
    force_hacking = "--hacking" in sys.argv
    force_windows = "--windows" in sys.argv

    if force_gui and force_cli:
        print("Error: --gui & --cli tidak boleh bersamaan.", file=sys.stderr); return 1
    modes_set = [m for m, f in [("coding", force_coding), ("hacking", force_hacking),
                                ("windows", force_windows)] if f]
    if len(modes_set) > 1:
        print(f"Error: hanya satu mode flag boleh dipakai ({modes_set}).",
              file=sys.stderr); return 1

    if hasattr(os, "geteuid") and os.geteuid() == 0 and not check:
        print("⚠️  Running as root.", file=sys.stderr)

    # 1) Mode
    if modes_set:
        mode = modes_set[0]
    elif check:
        mode = "coding"
    else:
        mode = select_mode_menu()

    # 2) Check
    if check:
        provider = os.getenv("AI_PROVIDER", "gemini").lower()
        if provider not in PROVIDER_NAMES:
            print(f"Error: AI_PROVIDER={provider!r}.", file=sys.stderr); return 1
        os.environ["AI_PROVIDER"] = provider
        return 0 if check_credentials(mode) else 1

    # 3) Interface
    if force_gui:
        interface = "gui"
    elif force_cli or no_menu:
        interface = "cli"
    else:
        interface = select_interface_menu()
    if interface == "gui" and not TKINTER_AVAILABLE:
        print("Warning: tkinter tidak tersedia, pakai CLI.", file=sys.stderr)
        interface = "cli"

    base = Path.cwd().resolve()

    # Platform check for windows mode
    if mode == "windows" and not IS_WINDOWS:
        print(f"⚠️  Mode windows dijalankan di {platform.system()} — "
              f"pygetwindow hanya Windows; mouse/keyboard tetap jalan di X11.",
              file=sys.stderr)

    if interface == "gui":
        AgentGUI(base, mode=mode).run()
        return 0

    # CLI path
    if no_menu:
        provider = os.getenv("AI_PROVIDER", "gemini").lower()
        if provider not in PROVIDER_NAMES:
            print(f"Error: AI_PROVIDER={provider!r}.", file=sys.stderr); return 1
    else:
        provider = select_provider_menu()
    os.environ["AI_PROVIDER"] = provider

    ok, gm = ensure_api_key_cli(provider)
    if not ok:
        print("Dibatalkan: API key tidak tersedia.", file=sys.stderr); return 1

    try:
        llm = create_llm_client(provider, gemini_mode=gm, mode=mode)
    except Exception as exc:
        print(f"Error init provider: {exc}", file=sys.stderr)
        print("Hint: `python agent.py --check` untuk diagnosa.", file=sys.stderr)
        return 1

    return run_cli(llm, provider, base, mode=mode)


if __name__ == "__main__":
    sys.exit(main())