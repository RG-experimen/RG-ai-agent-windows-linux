def _probe(factory, label: str) -> bool:
    print(f"  → {label}...")
    client = None
    try:
        client = factory()
        raw = client.send_message(
            'Return this JSON: {"action":"chat","parameters":{"message":"hello"}}')
        a, p = validate_action(parse_ai_response(raw), mode="coding")
        if a != "chat":
            raise ValueError("Probe not a valid chat action.")
        print("    ✅ OK")
        return True
    except Exception as exc:
        print(f"    ❌ {type(exc).__name__}: {exc}")
        return False
    finally:
        if client:
            client.close()


