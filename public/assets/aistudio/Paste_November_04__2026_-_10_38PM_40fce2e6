# ---------- File helpers ----------
def safe_path(path: str, base: Path) -> Path:
    if not isinstance(path, str) or not path.strip():
        raise ValueError("Path kosong.")
    req = Path(path).expanduser()
    if req.is_absolute():
        raise PermissionError("Gunakan path relatif.")
    resolved = (base / req).resolve()
    if resolved != base and base not in resolved.parents:
        raise PermissionError(f"Di luar working dir: {path}")
    if any(part in SENSITIVE_NAMES or part.startswith(".env.")
           for part in resolved.relative_to(base).parts):
        raise PermissionError(f"File sensitif: {path}")
    return resolved


def search_code(query: str, path: str, file_pattern: str, base: Path) -> dict[str, Any]:
    if not query:
        return {"error": "Query kosong."}
    fp = file_pattern or "*"
    if fp.startswith(("/", "\\")) or ".." in fp.split("/"):
        return {"error": f"Pola tidak valid: {fp!r}"}
    try:
        root = safe_path(path or ".", base)
    except (ValueError, PermissionError) as exc:
        return {"error": str(exc)}
    if not root.exists():
        return {"error": f"Tidak ditemukan: {path}"}
    cands = root.rglob(fp) if root.is_dir() else [root]
    out: list[dict[str, Any]] = []
    for cand in cands:
        try:
            rel = cand.relative_to(base)
            cand = safe_path(str(rel), base)
            rel = cand.relative_to(base)
        except (ValueError, PermissionError):
            continue
        if not cand.is_file() or any(p in IGNORED_DIRS for p in rel.parts):
            continue
        try:
            if cand.stat().st_size > MAX_SEARCH_FILE_BYTES:
                continue
            lines = cand.read_text(encoding="utf-8", errors="replace").splitlines()
        except (OSError, ValueError):
            continue
        for i, line in enumerate(lines, 1):
            if query.casefold() in line.casefold():
                out.append({"path": str(rel), "line": i, "text": line.strip()[:500]})
                if len(out) >= MAX_SEARCH_MATCHES:
                    return {"matches": out, "limited": True}
    return {"matches": out, "limited": False}


def ask_permission(description: str) -> bool:
    if PERMISSION_HANDLER is not None:
        return PERMISSION_HANDLER(description)
    print(f"\n[!] Agent meminta izin:\n{description}")
    try:
        ans = input("Izinkan? [y/N]: ").strip().casefold()
    except (EOFError, KeyboardInterrupt):
        print("\nDibatalkan.")
        return False
    return ans in {"y", "yes"}


def read_file(path: str, base: Path) -> dict[str, Any]:
    try:
        fp = safe_path(path, base)
    except (ValueError, PermissionError) as exc:
        return {"error": str(exc)}
    if not fp.is_file():
        return {"error": f"File tidak ditemukan: {path}"}
    try:
        with open(fp, "rb") as fh:
            data = fh.read(MAX_READ_BYTES + 1)
        trunc = len(data) > MAX_READ_BYTES
        if trunc:
            data = data[:MAX_READ_BYTES]
        return {"path": str(fp.relative_to(base)),
                "content": data.decode("utf-8", errors="replace"),
                "truncated": trunc}
    except OSError as exc:
        return {"error": str(exc)}


def write_file(path: str, content: str, base: Path) -> dict[str, Any]:
    try:
        fp = safe_path(path, base)
    except (ValueError, PermissionError) as exc:
        return {"error": str(exc)}
    if not isinstance(content, str):
        return {"error": "Content harus teks."}
    if len(content.encode("utf-8")) > MAX_WRITE_BYTES:
        return {"error": f"Melebihi {MAX_WRITE_BYTES} byte."}
    if not ask_permission(f"Tulis file → {fp.relative_to(base)}"):
        return {"error": "Ditolak."}
    tmp = None
    try:
        fp.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                         dir=fp.parent, prefix=".agent-",
                                         suffix=".tmp", delete=False) as tf:
            tf.write(content); tmp = tf.name
        Path(tmp).replace(fp)
        return {"path": str(fp.relative_to(base)), "written": True}
    except OSError as exc:
        if tmp:
            try: Path(tmp).unlink(missing_ok=True)
            except OSError: pass
        return {"error": str(exc)}


# ---------- Command handlers ----------
def check_self_destruct(command: str) -> Optional[str]:
    for pat, reason in _SELF_DESTRUCT_PATTERNS:
        if re.search(pat, command):
            return reason
    return None


def run_coding_command(command: str, base: Path) -> dict[str, Any]:
    try:
        parts = shlex.split(command)
    except ValueError as exc:
        return {"error": f"Format tidak valid: {exc}"}
    if not parts:
        return {"error": "Command kosong."}
    exe = parts[0]
    if IS_WINDOWS:
        allowed = (
            exe in {"cd", "dir", "type"}
            or (exe == "git" and len(parts) >= 2 and parts[1] in {"status", "diff", "log"})
            or (exe in {"python", "python3", "py"} and parts[1:] == ["--version"])
        )
        hint = "cd, dir, type, git status/diff/log, python --version"
    else:
        allowed = (
            exe in {"pwd", "ls", "cat"}
            or (exe == "git" and len(parts) >= 2 and parts[1] in {"status", "diff", "log"})
            or (exe in {"python", "python3"} and parts[1:] == ["--version"])
        )
        hint = "pwd, ls, cat, git status/diff/log, python --version"
    if not allowed:
        return {"error": f"Diblokir. Coding mode allowlist: {hint}. "
                         f"(Ganti ke mode hacking untuk full shell.)"}
    if not ask_permission(f"$ {command}"):
        return {"error": "Ditolak."}
    try:
        r = subprocess.run(parts, cwd=base, text=True, capture_output=True,
                           timeout=20, check=False, shell=False)
        return {"exit_code": r.returncode,
                "stdout": r.stdout[-12_000:], "stderr": r.stderr[-12_000:]}
    except subprocess.TimeoutExpired:
        return {"error": "Timeout 20s."}
    except OSError as exc:
        return {"error": str(exc)}


def run_hacking_command(command: str, base: Path) -> dict[str, Any]:
    if not command.strip():
        return {"error": "Command kosong."}
